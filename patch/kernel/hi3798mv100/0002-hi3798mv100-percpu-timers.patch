--- /dev/null
+++ b/drivers/clocksource/timer-hi3798mv100.c
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Hi3798MV100: one free-running counter and four independently routed ticks.
+ * The register windows and SPI routing match the MV100 SDK's hisp804 mapping.
+ */
+#include <linux/clk.h>
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/cpuhotplug.h>
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/percpu.h>
+#include <linux/sched_clock.h>
+#include <linux/smp.h>
+#ifdef CONFIG_ARM
+#include <linux/delay.h>
+#endif
+#include "timer-sp.h"
+
+struct mv100_tick {
+	struct clock_event_device event;
+	void __iomem *base;
+	unsigned long rate;
+	char name[24];
+};
+
+static DEFINE_PER_CPU(struct mv100_tick, mv100_ticks);
+static void __iomem *mv100_counter;
+
+static u64 notrace mv100_read_sched_clock(void)
+{
+	return ~readl_relaxed(mv100_counter + TIMER_VALUE);
+}
+
+#ifdef CONFIG_ARM
+static unsigned long mv100_read_delay(void)
+{
+	return ~readl_relaxed(mv100_counter + TIMER_VALUE);
+}
+static struct delay_timer mv100_delay = {
+	.read_current_timer = mv100_read_delay,
+};
+#endif
+
+static int mv100_tick_shutdown(struct clock_event_device *event)
+{
+	struct mv100_tick *tick = container_of(event, struct mv100_tick, event);
+
+	writel(0, tick->base + TIMER_CTRL);
+	writel(1, tick->base + TIMER_INTCLR);
+	return 0;
+}
+
+static void mv100_program_tick(struct mv100_tick *tick, u32 cycles, u32 mode)
+{
+	writel(TIMER_CTRL_32BIT, tick->base + TIMER_CTRL);
+	/* The SDK repeats LOAD writes on these timer channels. */
+	writel(cycles, tick->base + TIMER_LOAD);
+	writel(cycles, tick->base + TIMER_LOAD);
+	writel(TIMER_CTRL_32BIT | TIMER_CTRL_IE | TIMER_CTRL_ENABLE | mode,
+	       tick->base + TIMER_CTRL);
+}
+
+static int mv100_tick_next(unsigned long cycles, struct clock_event_device *event)
+{
+	struct mv100_tick *tick = container_of(event, struct mv100_tick, event);
+
+	mv100_program_tick(tick, cycles, TIMER_CTRL_ONESHOT);
+	return 0;
+}
+
+static int mv100_tick_periodic(struct clock_event_device *event)
+{
+	struct mv100_tick *tick = container_of(event, struct mv100_tick, event);
+
+	mv100_program_tick(tick, DIV_ROUND_CLOSEST(tick->rate, HZ), TIMER_CTRL_PERIODIC);
+	return 0;
+}
+
+static irqreturn_t mv100_tick_interrupt(int irq, void *data)
+{
+	struct mv100_tick *tick = data;
+
+	writel(1, tick->base + TIMER_INTCLR);
+	tick->event.event_handler(&tick->event);
+	return IRQ_HANDLED;
+}
+
+static int mv100_tick_starting(unsigned int cpu)
+{
+	struct mv100_tick *tick = per_cpu_ptr(&mv100_ticks, cpu);
+	int ret;
+
+	mv100_tick_shutdown(&tick->event);
+	ret = irq_force_affinity(tick->event.irq, cpumask_of(cpu));
+	if (ret)
+		return ret;
+	clockevents_config_and_register(&tick->event, tick->rate, 0xf, 0x7fffffff);
+	enable_irq(tick->event.irq);
+	return 0;
+}
+
+static int mv100_tick_dying(unsigned int cpu)
+{
+	struct mv100_tick *tick = per_cpu_ptr(&mv100_ticks, cpu);
+
+	disable_irq_nosync(tick->event.irq);
+	return mv100_tick_shutdown(&tick->event);
+}
+
+static int __init mv100_timer_init(struct device_node *node)
+{
+	struct clk *clock;
+	unsigned long rate;
+	unsigned int cpu;
+	int ret;
+
+	if (num_possible_cpus() > of_irq_count(node))
+		return -EINVAL;
+	clock = of_clk_get(node, 0);
+	if (IS_ERR(clock))
+		return PTR_ERR(clock);
+	ret = clk_prepare_enable(clock);
+	if (ret)
+		return ret;
+	rate = clk_get_rate(clock);
+	if (!rate)
+		return -EINVAL;
+	mv100_counter = of_iomap(node, 0);
+	if (!mv100_counter)
+		return -ENOMEM;
+
+	for_each_possible_cpu(cpu) {
+		struct mv100_tick *tick = per_cpu_ptr(&mv100_ticks, cpu);
+		struct clock_event_device *event = &tick->event;
+
+		tick->base = of_iomap(node, cpu + 1);
+		if (!tick->base)
+			return -ENOMEM;
+		tick->rate = rate;
+		snprintf(tick->name, sizeof(tick->name), "mv100-tick%u", cpu);
+		event->name = tick->name;
+		event->irq = irq_of_parse_and_map(node, cpu);
+		if (!event->irq)
+			return -EINVAL;
+		event->cpumask = cpumask_of(cpu);
+		event->rating = 400;
+		event->features = CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT |
+				  CLOCK_EVT_FEAT_PERCPU;
+		event->set_state_shutdown = mv100_tick_shutdown;
+		event->set_state_oneshot = mv100_tick_shutdown;
+		event->tick_resume = mv100_tick_shutdown;
+		event->set_state_periodic = mv100_tick_periodic;
+		event->set_next_event = mv100_tick_next;
+		mv100_tick_shutdown(event);
+		ret = request_irq(event->irq, mv100_tick_interrupt,
+				  IRQF_TIMER | IRQF_NOBALANCING | IRQF_NO_AUTOEN,
+				  tick->name, tick);
+		if (ret)
+			return ret;
+	}
+
+	writel(0, mv100_counter + TIMER_CTRL);
+	writel(U32_MAX, mv100_counter + TIMER_LOAD);
+	writel(TIMER_CTRL_32BIT | TIMER_CTRL_PERIODIC | TIMER_CTRL_ENABLE,
+	       mv100_counter + TIMER_CTRL);
+	ret = clocksource_mmio_init(mv100_counter + TIMER_VALUE, "mv100-counter",
+				   rate, 400, 32, clocksource_mmio_readl_down);
+	if (ret)
+		return ret;
+	sched_clock_register(mv100_read_sched_clock, 32, rate);
+#ifdef CONFIG_ARM
+	mv100_delay.freq = rate;
+	register_current_timer_delay(&mv100_delay);
+#endif
+	return cpuhp_setup_state(CPUHP_AP_HI3798_TIMER_STARTING,
+				 "clockevents/hi3798mv100:starting",
+				 mv100_tick_starting, mv100_tick_dying);
+}
+TIMER_OF_DECLARE(mv100, "hisilicon,hi3798mv100-timer", mv100_timer_init);
--- a/drivers/clocksource/Makefile
